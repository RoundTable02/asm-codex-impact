APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# fake is for tests only. Production requires openai and a server-side API key.
AI_MODE=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_LLM_MODEL=gpt-4.1-mini
# Hackathon demo only. Replace with the frontend origin before handling real data.
CORS_ORIGINS=*
AUDIO_TEMP_DIR=/tmp/social-worker-ax
MAX_AUDIO_BYTES=26214400
JOB_POLL_SECONDS=0.2
CASE_REPORT_TIMEOUT_SECONDS=30
